-- ============================================================
-- 停用模式（還原重力、清理連線）
-- ============================================================
local function deactivateMode()
    toggles.ragdollTeleport = false

    if connections.ragdollConn then
        pcall(function() connections.ragdollConn:Disconnect() end)
        connections.ragdollConn = nil
    end
    if connections.gravityLoop then
        task.cancel(connections.gravityLoop)
        connections.gravityLoop = nil
    end
    if connections.deathWatcher then
        pcall(function() connections.deathWatcher:Disconnect() end)
        connections.deathWatcher = nil
    end

    pcall(function() Workspace.Gravity = DEFAULT_GRAVITY end)
end

