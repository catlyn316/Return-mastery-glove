-- 隨機主題色生成（每次載入皆不同）
-- ============================================================
local function randomHue()
    local hues = {
        {200, 180, 240},
        {80,  200, 170},
        {180, 100, 240},
        {240, 140, 80},
        {80,  220, 110},
        {240, 80,  140},
        {100, 180, 255},
        {255, 210, 60},
        {200, 80,  80},
        {80,  240, 200},
    }
    local h = hues[math.random(1, #hues)]
    return h[1], h[2], h[3]
end

local r, g, b = randomHue()

local function mkColor(rr, gg, bb) return Color3.fromRGB(rr, gg, bb) end
local function darken(rr, gg, bb, f) f = f or 0.5 return mkColor(math.floor(rr*f), math.floor(gg*f), math.floor(bb*f)) end
local function lighten(rr, gg, bb, f) f = f or 1.4
    return mkColor(math.min(255,math.floor(rr*f)), math.min(255,math.floor(gg*f)), math.min(255,math.floor(bb*f)))
end

