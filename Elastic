-- ============================================================
-- 核心邏輯：偵測 Ragdolled → 傳送 + 重力控制 + 死亡監聽
-- ============================================================
local function startMode()
    -- 設定低重力迴圈
    connections.gravityLoop = task.spawn(function()
        while toggles.ragdollTeleport do
            pcall(function() Workspace.Gravity = GRAVITY_VALUE end)
            task.wait(0.1)
        end
    end)

    -- 監聽死亡（Humanoid.Died）
    local function watchDeath()
        if connections.deathWatcher then
            pcall(function() connections.deathWatcher:Disconnect() end)
            connections.deathWatcher = nil
        end
        local char = player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        connections.deathWatcher = hum.Died:Connect(function()
            if not toggles.ragdollTeleport then return end
            deactivateMode()
            resetUIToOff()
        end)
    end

    watchDeath()

    -- 若角色重生，重新綁定死亡監聽
    player.CharacterAdded:Connect(function()
        if toggles.ragdollTeleport then
            watchDeath()
        end
    end)

    -- 偵測 Ragdolled
    local ragdolledObj = nil

    local function findRagdolledObj()
        local folder = Workspace:FindFirstChild(player.Name)
        if folder then ragdolledObj = folder:FindFirstChild("Ragdolled") end
    end

    local function tryConnect()
        findRagdolledObj()
        if not ragdolledObj then return end

        if connections.ragdollConn then
            pcall(function() connections.ragdollConn:Disconnect() end)
        end

        connections.ragdollConn = ragdolledObj.Changed:Connect(function(newVal)
            if not toggles.ragdollTeleport then return end
            if newVal == true then
                local char = player.Character
                if char then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        pcall(function() hrp.CFrame = CFrame.new(TELEPORT_TARGET) end)
                    end
                end
            end
        end)
    end

    tryConnect()

    if not ragdolledObj then
        task.spawn(function()
            local t = tick()
            while toggles.ragdollTeleport and (tick() - t) < 30 do
                findRagdolledObj()
                if ragdolledObj then tryConnect() break end
                task.wait(0.5)
            end
        end)
    end
end

