local function findPlayerByPartialName(input)
    if not input or input == "" then return nil, "請輸入玩家名稱" end
    input = input:lower()
    local matches = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            if p.Name:lower():sub(1, #input) == input or p.DisplayName:lower():sub(1, #input) == input then
                table.insert(matches, p)
            end
        end
    end
    if #matches == 0 then return nil, "找不到玩家"
    elseif #matches == 1 then return matches[1], nil
    else
        local names = {}
        for _, p in ipairs(matches) do table.insert(names, p.Name) end
        return nil, "找到多個玩家: " .. table.concat(names, ", ") .. "\n請輸入更多字元"
    end
end

local function getNearestTarget()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = char.HumanoidRootPart.Position
    local nearest, minDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local d = (p.Character.HumanoidRootPart.Position - myPos).Magnitude
            if d < minDist then minDist = d nearest = p end
        end
    end
    return nearest
end

-- 偵測 45 單位內所有 DicePart，若任一 TextLabel.Text > 60 則回傳 true
local function checkNearbyDiceOver(threshold, range)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local myPos = char.HumanoidRootPart.Position

    -- 搜尋 Workspace 下所有名為 DicePart 的物件
    local function searchInParent(parent)
        for _, obj in ipairs(parent:GetChildren()) do
            if obj.Name == "DicePart" then
                local rootPart = obj:FindFirstChild("HumanoidRootPart") or obj
                if rootPart:IsA("BasePart") then
                    if (rootPart.Position - myPos).Magnitude <= range then
                        -- 嘗試讀取 BillboardGui > ImageLabel > TextLabel 的 Text
                        local billboard = obj:FindFirstChild("BillboardGui")
                        if billboard then
                            local imgLabel = billboard:FindFirstChild("ImageLabel")
                            if imgLabel then
                                local textLabel = imgLabel:FindFirstChild("TextLabel")
                                if textLabel then
                                    local val = tonumber(textLabel.Text)
                                    if val and val > threshold then
                                        return true
                                    end
                                end
                            end
                        end
                    end
                end
            end
            -- 遞迴搜尋子物件（DicePart 可能不在頂層）
            if #obj:GetChildren() > 0 then
                if searchInParent(obj) then return true end
            end
        end
        return false
    end

    return searchInParent(Workspace)
end

