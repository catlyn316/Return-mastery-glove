-- ============================================================
-- Ragdoll 偵測設定
-- ============================================================
local function setupRagdollDetection()
    if ragdolledConn then pcall(function() ragdolledConn:Disconnect() end) end
    ragdolledConn = nil
    isRagdolled   = false

    local function tryConnectRagdolledValue()
        local folder = Workspace:FindFirstChild(player.Name)
        if folder then
            local rv = folder:FindFirstChild("Ragdolled")
            if rv then
                ragdolledConn = rv.Changed:Connect(function(val)
                    isRagdolled = (val == true)
                end)
                return true
            end
        end
        return false
    end

    if not tryConnectRagdolledValue() then
        local char = player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                ragdolledConn = hum.StateChanged:Connect(function(_, newState)
                    if newState == Enum.HumanoidStateType.FallingDown
                    or newState == Enum.HumanoidStateType.Ragdoll then
                        isRagdolled = true
                    elseif newState == Enum.HumanoidStateType.GettingUp
                    or     newState == Enum.HumanoidStateType.Running
                    or     newState == Enum.HumanoidStateType.Landed then
                        isRagdolled = false
                    end
                end)
            end
        end
    end
end

player.CharacterAdded:Connect(function()
    task.wait(0.5)
    setupRagdollDetection()
end)
if player.Character then setupRagdollDetection() end

-- ============================================================
-- 輔助：尋找最近玩家
-- ============================================================
local function findClosestPlayer()
    local closestPlayer    = nil
    local shortestDistance = math.huge
    local localCharacter   = player.Character
    if not localCharacter or not localCharacter:FindFirstChild("HumanoidRootPart") then return nil end
    local localPosition = localCharacter.HumanoidRootPart.Position
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local d = (p.Character.HumanoidRootPart.Position - localPosition).Magnitude
            if d < shortestDistance then
                shortestDistance = d
                closestPlayer    = p
            end
        end
    end
    return closestPlayer
end

-- ============================================================
-- 輔助：模糊查玩家
-- ============================================================
local function findPlayerByPartialName(input)
    if not input or input == "" then return nil, "請輸入玩家名稱" end
    input = input:lower()
    local matches = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            if p.Name:lower():sub(1, #input) == input
            or p.DisplayName:lower():sub(1, #input) == input then
                table.insert(matches, p)
            end
        end
    end
    if #matches == 0    then return nil, "找不到玩家"
    elseif #matches > 1 then
        local names = {}
        for _, p in ipairs(matches) do table.insert(names, p.Name) end
        return nil, "找到多個: " .. table.concat(names, ", ")
    end
    return matches[1], nil
end

-- ============================================================
-- ① 自動攻擊（第三任務：最近玩家 + GeneralHit）
-- ============================================================
local function runAutoAttackLoop()
    while toggles.autoAttack do
        local cp = findClosestPlayer()
        if cp and cp.Character and cp.Character:FindFirstChild("Head") then
            pcall(function()
                ReplicatedStorage.GeneralHit:FireServer(cp.Character.Head)
            end)
        end
        task.wait(math.max(0.1, values.attackInterval))
    end
end

-- ============================================================
-- ② 幫助者：位置保持輔助
-- ============================================================
local function applyHelpPosition(hrp, tgt)
    pcall(function()
        if toggles.fixedPosHelp and values.fixedCFrame then
            hrp.CFrame = values.fixedCFrame
        elseif not toggles.fixedPosHelp then
            local tgtRoot = tgt.Character and tgt.Character:FindFirstChild("HumanoidRootPart")
            if tgtRoot then
                local ld  = tgtRoot.CFrame.LookVector
                local pos = tgtRoot.Position + ld * values.helpDistance
                hrp.CFrame = CFrame.new(pos, pos + ld)
            end
        end
    end)
end

-- ============================================================
-- ② 幫助者 - 被打後不重置（只保持位置）
-- ============================================================
local function runHelpLoopNoReset(hrp, hum, tgt)
    while toggles.helpTarget do
        if not (hrp and hrp.Parent) then break end
        if hum.Health <= 0 then break end
        applyHelpPosition(hrp, tgt)
        task.wait(0.05)
    end
end

-- ============================================================
-- ② 幫助者 - 被打後重置（進階三段判定）
--    階段一「正常」  → LastSlappedBy 變成目標名字
--    階段二「等恢復」→ 等自己從 ragdoll 站起來
--    階段三「等二次」→ 再次進入 ragdoll 時觸發 Reset
-- ============================================================
local function runHelpLoopReset(hrp, hum, tgt)
    local lsbObj   = nil
    local lsbConn  = nil
    local phase    = "正常"

    -- 取得 LastSlappedBy
    pcall(function()
        local folder = Workspace:FindFirstChild(player.Name)
        if folder then lsbObj = folder:FindFirstChild("LastSlappedBy") end
    end)

    local function setupLSBConn()
        if lsbConn then pcall(function() lsbConn:Disconnect() end) end
        if not lsbObj or not lsbObj.Parent then return end
        lsbConn = lsbObj.Changed:Connect(function(newVal)
            if phase == "正常" then
                if newVal == tgt.Name or newVal == tgt.DisplayName then
                    phase = "等恢復"
                end
            end
        end)
    end

    -- 輔助：直接讀 Workspace.玩家名.Ragdolled.Value
    local function getRagdolled()
        local val = false
        pcall(function()
            local folder = Workspace:FindFirstChild(player.Name)
            if folder then
                local rv = folder:FindFirstChild("Ragdolled")
                if rv then val = (rv.Value == true) end
            end
        end)
        return val
    end

    setupLSBConn()

    local prevRagdolled = getRagdolled()

    while toggles.helpTarget do
        if not (hrp and hrp.Parent) then break end
        if hum.Health <= 0 then break end

        -- 補回失效的 lsbObj
        if not lsbObj or not lsbObj.Parent then
            pcall(function()
                local folder = Workspace:FindFirstChild(player.Name)
                if folder then lsbObj = folder:FindFirstChild("LastSlappedBy") end
            end)
            setupLSBConn()
        end

        local nowRagdolled = getRagdolled()

        if phase == "等恢復" then
            -- 等自己從 ragdoll 站起來（Ragdolled 變 false）
            if not nowRagdolled then
                phase = "等二次"
            end

        elseif phase == "等二次" then
            -- 主動偵測 Ragdolled 從 false → true（上升緣）
            if nowRagdolled and not prevRagdolled then
                -- 觸發重置
                phase = "正常"
                if lsbConn then pcall(function() lsbConn:Disconnect() end) end
                pcall(function() player.Reset:FireServer() end)
                task.wait(0.1)
                break
            end
        end

        prevRagdolled = nowRagdolled
        applyHelpPosition(hrp, tgt)
        task.wait(0.05)
    end

    if lsbConn then pcall(function() lsbConn:Disconnect() end) end
end

-- ============================================================
-- ② 幫助者外層循環（傳送 + 選模式）
-- ============================================================
local function runHelpLoop(tgt)
    local function waitAlive(timeout)
        local t = tick()
        while tick() - t < (timeout or 15) do
            if not toggles.helpTarget then return nil, nil end
            local c = player.Character
            if c then
                local hrp = c:FindFirstChild("HumanoidRootPart")
                local hum = c:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then return hrp, hum end
            end
            task.wait(0.2)
        end
        return nil, nil
    end

    local function teleportToLobby(hrp)
        pcall(function()
            local tp1 = Workspace.Lobby and Workspace.Lobby:FindFirstChild("Teleport1")
            if tp1 and hrp and hrp.Parent then hrp.CFrame = tp1.CFrame end
        end)
    end

    local function teleportToTarget(hrp)
        pcall(function()
            if not (hrp and hrp.Parent) then return end
            local tgtRoot = tgt.Character and tgt.Character:FindFirstChild("HumanoidRootPart")
            if tgtRoot then
                local ld  = tgtRoot.CFrame.LookVector
                local pos = tgtRoot.Position + ld * values.helpDistance
                local cf  = CFrame.new(pos, pos + ld)
                hrp.CFrame         = cf
                values.fixedCFrame = cf
            end
        end)
    end

    while toggles.helpTarget do
        local hrp, hum = waitAlive(15)
        if not hrp then task.wait(0.5) continue end
        if not toggles.helpTarget then break end

        values.fixedCFrame = nil
        teleportToLobby(hrp)
        task.wait(0.5)
        if not toggles.helpTarget then break end

        -- 傳送到目標前方
        local tpSuccess = false
        local tpStart   = tick()
        while toggles.helpTarget and tick() - tpStart < 5 do
            teleportToTarget(hrp)
            pcall(function()
                local tgtRoot = tgt.Character and tgt.Character:FindFirstChild("HumanoidRootPart")
                if tgtRoot and hrp and hrp.Parent then
                    if (tgtRoot.Position - hrp.Position).Magnitude <= values.helpDistance + 5 then
                        tpSuccess = true
                    end
                end
            end)
            if tpSuccess then break end
            task.wait(0.5)
        end
        if not toggles.helpTarget or not tpSuccess then continue end

        local helpDone   = false
        local lobbyStuck = false

        -- 無工具偵測（卡大廳）
        local noToolTimer  = 0
        local noToolThread = task.spawn(function()
            while not helpDone and toggles.helpTarget do
                local hasTool = false
                local c = player.Character
                if c then
                    for _, v in ipairs(c:GetChildren()) do
                        if v:IsA("Tool") then hasTool = true break end
                    end
                    local bp = player:FindFirstChildOfClass("Backpack")
                    if bp and not hasTool then
                        for _, v in ipairs(bp:GetChildren()) do
                            if v:IsA("Tool") then hasTool = true break end
                        end
                    end
                end
                noToolTimer = hasTool and 0 or noToolTimer + 0.1
                if noToolTimer >= 0.5 then lobbyStuck = true helpDone = true end
                task.wait(0.1)
            end
        end)

        -- 根據幫助模式選分支
        local helpConn = task.spawn(function()
            if values.helpMode == "被打後重置" then
                runHelpLoopReset(hrp, hum, tgt)
            else
                runHelpLoopNoReset(hrp, hum, tgt)
            end
            helpDone = true
        end)
        while not helpDone and toggles.helpTarget do task.wait(0.1) end
        pcall(function() task.cancel(helpConn) end)

        helpDone = true
        pcall(function() task.cancel(noToolThread) end)

        if lobbyStuck and toggles.helpTarget then
            teleportToLobby(hrp)
            task.wait(0.5)
        end
    end
end

